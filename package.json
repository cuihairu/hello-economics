{
  "name": "hello-economics",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vitepress dev docs",
    "build": "vitepress build docs && node scripts/check-rendered-math.cjs",
    "preview": "vitepress preview docs",
    "glossary": "node scripts/build-glossary.cjs",
    "test": "node --test \"tests/*.test.mjs\" && vitest run",
