    "check:latex": "node scripts/check-latex.cjs"
  },
  "devDependencies": {
    "@mdit/plugin-katex": "^1.1.3",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitest/coverage-v8": "5.0.2",
    "@vue/test-utils": "^2.5.1",
    "@vueuse/motion": "^3.0.3",
    "happy-dom": "^20.14.5",
    "katex": "^0.18.9",
    "markdown-it": "^15.0.2",
    "vitepress": "^1.6.4",
    "vitest": "^5.0.2",
    "vue": "^3.5.43"
  }
}
